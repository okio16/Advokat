# Apache: адресите остават същите като досега – /uslugi се отваря от uslugi.html.
Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

RewriteEngine On

# https и без www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://advokat-angeldimitrov.com%{REQUEST_URI} [R=301,L]

# Старите адреси
RewriteRule ^za-men/?$ /#forMe [R=301,NE,L]
RewriteRule ^(en|ru)/za-men/?$ /$1#forMe [R=301,NE,L]
RewriteRule ^bg/?$ / [R=301,L]
RewriteRule ^bg/(.*)$ /$1 [R=301,L]

# /страница.html → /страница
RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteRule ^index$ / [R=301,L]

# Наклонена черта накрая → без нея
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]

# /uslugi → uslugi.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
